# Credentials
.env

# Data files, regenerated by the pipeline.
# Git will not descend into an excluded directory, so the subdirectories must
# be re-included before a rule inside them can take effect. That is why the
# SOURCE.md exception below needs the two directory lines above it.
data/landing/**
!data/landing/
!data/landing/*/
!data/landing/*/SOURCE.md

data/raw/*
data/curated/*
!data/landing/.gitkeep
!data/raw/.gitkeep
!data/curated/.gitkeep

# Scraped property listings, held outside the data tree by the scraping members
domain/

*.parquet
*.gpkg
*.shp
*.shx
*.dbf
*.prj
*.zip
*.xlsx
*.csv

# Cache, including cached API responses
cache/
__pycache__/
*.pyc

# Notebooks
.ipynb_checkpoints/

# OS
.DS_Store
.Rhistory
