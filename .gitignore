# Credentials
.env

# Data files, regenerated by the pipeline.
# Git will not descend into an excluded directory, so the subdirectories must
# be re-included before a rule inside them can take effect. That is why the
# SOURCE.md exception below needs the two directory lines above it.
data/landing/**
!data/landing/
!data/landing/*/
!data/landing/*/SOURCE.md

data/raw/*
data/curated/*
!data/landing/.gitkeep
!data/raw/.gitkeep
!data/curated/.gitkeep

# Scraped property listings, held outside the data tree by the scraping members
domain/

# Data formats, excluded wherever they appear
*.parquet
*.gpkg
*.shp
*.shx
*.dbf
*.prj
*.zip
*.xlsx
*.csv

# Final deliverables are committed by exception, and must stay below the
# format rules above, since a later rule overrides an earlier one. The tabular
# feature table is a few hundred kilobytes and is the only file the modelling
# and visualisation members need, so keeping it in the repository saves each
# of them downloading five external datasets and rerunning the pipeline. The
# geopackage is not committed, since the geometry makes it far larger and only
# the mapping work uses it.
!data/curated/sa2_features.parquet
!data/curated/property_geo_features.parquet

# Keep cleaned listing datasets.
!data/analysis_data/**
!data/metadata/**

# Spark bookkeeping files are regenerated and are not needed to read Parquet.
*.crc
_SUCCESS
_temporary/

# Keep all merged-table outputs for sharing and review.
!data/curated/master_modelling_table_full.parquet
!data/curated/master_modelling_table.parquet
!data/curated/master_modelling_table.csv

# Cache, including cached API responses
cache/
__pycache__/
*.pyc

# Notebooks
.ipynb_checkpoints/

# Editor
settings.json
.vscode/

# OS
.DS_Store
.Rhistory
